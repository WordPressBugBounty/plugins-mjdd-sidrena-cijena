msgstr "Trenutno %d postavk. Dodajo se na konec javnega cenika."

msgid "U XML-u nisu pronađeni ponavljajući zapisi proizvoda."
msgstr "V XML-u niso bili najdeni ponavljajoči zapisi izdelkov."

msgid "U cjenik ove poslovnice ulaze samo odabrani proizvodi."
msgstr "V cenik te poslovalnice spadajo le izbrani izdelki."

msgid "URL"
msgstr "URL"

msgid "Uključeno po defaultu. Nakon 00:05 (vremenska zona WordPressa) regenerira se javni cjenik da bude dostupan prije zakonskog roka 08:00, i sprema se u arhivu pod službenim nazivom (max 30 datoteka)."
msgstr "Privzeto vključeno. Po 00:05 (časovni pas WordPressa) se regenerira javni cenik, da je na voljo pred zakonskim rokom 08:00, in se shrani v arhiv pod uradnim imenom (največ 30 datotek)."

msgid "Ukloni"
msgstr "Odstrani"

msgid "Ukloni poslovnicu"
msgstr "Odstrani poslovalnico"

msgid "Ulica i mjesto ostaju u nazivu, npr. Ilica 150 Zagreb."
msgstr "Ulica in kraj ostane v imenu, npr. Ilica 150 Zagreb."

msgid "Uploads mapa nije dostupna."
msgstr "Mapa uploads ni na voljo."

